# ================================================================
# SafeStep: Environment Configuration & API Keys
# ================================================================

# Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=True

# 1. Map & Routing Engine API Keys
# Mapbox Access Token (Optional: for satellite vector tiles & reverse geocoding)
# Obtain from: https://account.mapbox.com/
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSI...

# OpenRouteService (ORS) API Key (Optional: for cloud routing alternative to local OSRM)
# Obtain from: https://openrouteservice.org/
ORS_API_KEY=5b3ce3597851110001cf6248...

# 2. Authentication & User Profile (Firebase)
# Firebase Project Web Credentials for authenticated hazard submissions & contact sync
# Obtain from: https://console.firebase.google.com/
FIREBASE_API_KEY=AIzaSyA...
FIREBASE_AUTH_DOMAIN=safestep-protect.firebaseapp.com
FIREBASE_PROJECT_ID=safestep-protect
FIREBASE_STORAGE_BUCKET=safestep-protect.appspot.com
FIREBASE_MESSAGING_SENDER_ID=123456789012
FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# 3. Emergency SMS & Automated Alerts Gateway (Twilio)
# For dispatching real-time SMS alerts with live GPS tracking links to emergency contacts
# Obtain from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_PHONE_NUMBER=+1234567890

# 4. Computer Vision / Infrastructure Audit API
# For fine-tuned YOLO inference on street photos
# Obtain from: https://roboflow.com/ or Ultralytics HUB
ROBOFLOW_API_KEY=rf_your_roboflow_key_here
ROBOFLOW_MODEL_ENDPOINT=street-lighting-audit/1

# 5. Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://postgres:password@localhost:5432/safestep_db
